# ============================================
# 本番用 Flutter Web Dockerfile (Multi-stage build)
# ============================================

# ステージ1: ビルド環境
FROM ubuntu:22.04 AS builder

# 必要なツールをインストール
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Flutter SDKのインストール
ENV FLUTTER_HOME=/usr/local/flutter
ENV PATH=${FLUTTER_HOME}/bin:${PATH}

# Flutterの安定版をダウンロード
RUN git clone https://github.com/flutter/flutter.git ${FLUTTER_HOME} -b stable

# 権限設定
RUN git config --global --add safe.directory ${FLUTTER_HOME}
RUN git config --global --add safe.directory /app

# Web開発用の設定を有効化
RUN flutter config --enable-web

# 作業ディレクトリ設定
WORKDIR /app

# pubspec.yamlをコピーして依存関係を取得（キャッシュ効率化）
COPY src/pubspec.yaml src/pubspec.lock* ./

# 依存関係を取得
RUN flutter pub get

# ソースコードをコピー
COPY src/ ./

# 環境変数（ビルド時に設定）
ARG API_BASE_URL=http://localhost:8000
ARG ENV=production

# Flutter Webのリリースビルド
RUN flutter build web --release \
    --dart-define="ENV=${ENV}" \
    --dart-define="API_BASE_URL=${API_BASE_URL}" \
    --dart-define="USE_MOCK_API=false"

# ============================================
# ステージ2: 本番環境 (Nginx)
# ============================================
FROM nginx:alpine

# Nginxの設定ファイルをコピー
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

# ビルド成果物をNginxのドキュメントルートにコピー
COPY --from=builder /app/build/web /usr/share/nginx/html

# ヘルスチェック用
HEALTHCHECK --interval=30s --timeout=3s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# ポート80を公開
EXPOSE 80

# Nginxをフォアグラウンドで実行
CMD ["nginx", "-g", "daemon off;"]
